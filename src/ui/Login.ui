<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>Login</class>
 <widget class="QMainWindow" name="Login">
  <property name="geometry"><rect><x>0</x><y>0</y><width>400</width><height>300</height></rect></property>
  <property name="windowTitle"><string>Đăng Nhập Hệ Thống</string></property>
  <property name="styleSheet"><string>QWidget {
    font-family: 'Inter', 'Segoe UI', 'Arial', sans-serif;
    font-size: 14px;
    color: #18181b; /* kẽm-900 (zinc-900) - màu đen dịu */
    background-color: #fafafa; /* kẽm-50 (zinc-50) - nền trắng xám dịu mắt */
}

QMainWindow {
    background-color: #fafafa;
}

/* NÚT BẤM CHUNG - Màu Oceanic Azure #002B8C */
QPushButton {
    background-color: #0F52BA; /* Sapphire - Màu chính cho nút thao tác */
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    border: none;
}

QPushButton:hover {
    background-color: #002B8C; /* Oceanic Azure - Đậm hơn khi hover */
}

QPushButton:pressed {
    background-color: #282888; /* Indigo Blue - Khi nhấn */
}

/* NÚT ĐĂNG XUẤT / XÓA KHẨN CẤP */
QPushButton#btnLogout, QPushButton#btnDeleteUser, QPushButton#btnDeleteDoctor, QPushButton#btnDeleteMedicine, QPushButton#btnDeleteService {
    background-color: #e74c3c; /* Đỏ nhạt để cảnh báo */
}

QPushButton#btnLogout:hover, QPushButton#btnDeleteUser:hover, QPushButton#btnDeleteDoctor:hover, QPushButton#btnDeleteMedicine:hover, QPushButton#btnDeleteService:hover {
    background-color: #c0392b;
}

/* Ô NHẬP LIỆU (Input / ComboBox / SpinBox) */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background-color: white;
    border: 1px solid #e4e4e7; /* zinc-200 */
    border-radius: 6px;
    padding: 8px 12px;
    color: #3f3f46; /* zinc-700 */
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #0F52BA; /* Viền Sapphire khi focus */
    background-color: #F0FFFF; /* Azure nhạt khi focus */
}

/* BẢNG DỮ LIỆU (Table Widget) */
QTableView, QTableWidget {
    background-color: white;
    gridline-color: #f4f4f5; /* zinc-100 */
    border: 1px solid #e4e4e7; /* zinc-200 */
    border-radius: 8px;
    selection-background-color: #F0FFFF; /* Azure nhạt khi chọn */
    selection-color: #002B8C; /* Oceanic Azure đậm khi chọn */
}

/* TIÊU ĐỀ CỘT CỦA BẢNG */
QHeaderView::section {
    background-color: #f4f4f5; /* zinc-100 */
    color: #52525b; /* zinc-600 */
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #e4e4e7; /* zinc-200 */
    text-transform: uppercase;
}

QTableView::item {
    padding: 8px;
    border-bottom: 1px solid #f4f4f5;
}

QTableView::item:hover {
    background-color: #fafafa;
}
</string></property><widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
    <property name="leftMargin"><number>50</number></property>
    <property name="topMargin"><number>50</number></property>
    <property name="rightMargin"><number>50</number></property>
    <property name="bottomMargin"><number>50</number></property>
    <item><widget class="QLineEdit" name="txtUsername"><property name="placeholderText"><string>Tên đăng nhập</string></property><property name="minimumHeight"><number>40</number></property></widget></item>
    <item><widget class="QLineEdit" name="txtPassword"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>Mật khẩu</string></property><property name="minimumHeight"><number>40</number></property></widget></item>
    <item><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint"><size><width>20</width><height>20</height></size></property></spacer></item>
    <item><widget class="QPushButton" name="btnLogin"><property name="text"><string>Đăng Nhập</string></property><property name="minimumHeight"><number>45</number></property></widget></item>
   </layout>
  </widget>
 </widget>
</ui>