<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>InventoryMenu</class>
 <widget class="QMainWindow" name="InventoryMenu">
  <property name="geometry"><rect><x>0</x><y>0</y><width>900</width><height>600</height></rect></property>
  <property name="windowTitle"><string>Quản Lý Kho Thuốc - Inventory Menu</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain">
    <item>
     <layout class="QHBoxLayout" name="horizontalLayoutInputs">
      <!-- MỚI: Thêm cbMedPrefix để chọn nhóm thuốc BHYT -->
      <item><widget class="QComboBox" name="cbMedPrefix">
        <item><property name="text"><string>B1 - Thuốc cơ bản (BHYT trả 100%)</string></property></item>
        <item><property name="text"><string>B2 - Thuốc đặc trị (BHYT trả 50%)</string></property></item>
        <item><property name="text"><string>B3 - Thuốc khác (BHYT trả 80%)</string></property></item>
        <item><property name="text"><string>DV - Thuốc ngoài danh mục BHYT</string></property></item>
      </widget></item>
      
      <!-- Giữ lại ô txtMedId chỉ để bấm xóa/cập nhật -->
      <item><widget class="QLineEdit" name="txtMedId">
         <property name="placeholderText"><string>Mã Thuốc</string></property>
         <property name="readOnly"><bool>true</bool></property>
      </widget></item>
      
      <item><widget class="QLineEdit" name="txtMedName"><property name="placeholderText"><string>Tên Thuốc</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtDosage"><property name="placeholderText"><string>Liều lượng / Dạng</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtPrice"><property name="placeholderText"><string>Đơn giá</string></property></widget></item>
      <item><widget class="QSpinBox" name="spinBoxQty"><property name="value"><number>1</number></property></widget></item>
      <item><widget class="QPushButton" name="btnImportMedicine"><property name="text"><string>Nhập Thuốc Vào Kho</string></property></widget></item>
     </layout>
    </item>
    
    <item>
     <layout class="QHBoxLayout" name="horizontalLayoutSearch">
      <item><widget class="QLabel" name="lblSearchIcon"><property name="text"><string>🔍 Tra cứu:</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtSearchMed"><property name="placeholderText"><string>Gõ Mã Thuốc hoặc Tên Thuốc để tìm kiếm nhanh...</string></property></widget></item>
     </layout>
    </item>
    
    <item><widget class="QTableWidget" name="tableMedicines" /></item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayoutPrescriptionQueue">
      <item><widget class="QLabel" name="lblPrescriptionQueue">
       <property name="text"><string>Đơn thuốc chờ cấp phát</string></property>
      </widget></item>
      <item><spacer name="horizontalSpacerPrescription">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
      </spacer></item>
      <item><widget class="QPushButton" name="btnDispensePrescription">
       <property name="text"><string>Cấp phát thuốc đã chọn</string></property>
      </widget></item>
     </layout>
    </item>
    <item><widget class="QTableWidget" name="tablePendingPrescriptions" /></item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayoutBottom">
      <item><spacer name="horizontalSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item><widget class="QPushButton" name="btnLogout"><property name="text"><string>Đăng Xuất</string></property></widget></item>
     </layout>
    </item>
   </layout>
  </widget>
 </widget>
</ui>