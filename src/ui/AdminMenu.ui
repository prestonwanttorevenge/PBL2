          <item><widget class="QLineEdit" name="txtMedPrice"><property name="placeholderText"><string>Đơn giá</string></property></widget></item>
          <item><widget class="QSpinBox" name="spinMedQty"><property name="value"><number>1</number></property></widget></item>
