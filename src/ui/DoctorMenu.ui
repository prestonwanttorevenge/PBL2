<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <class>DoctorMenu</class>
 <widget class="QMainWindow" name="DoctorMenu">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1000</width><height>700</height></rect></property>
  <property name="windowTitle"><string>Giao Diện Bác Sĩ - Doctor Menu</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayoutMain">
    <item>
     <widget class="QTableWidget" name="tableAppointments" />
    </item>
    <item>
     <layout class="QVBoxLayout" name="verticalLayoutRightPanel">
      
      <!-- BẮT ĐẦU: NÚT HỦY LỊCH BỊ THIẾU ĐÃ ĐƯỢC THÊM VÀO -->
      <item><widget class="QPushButton" name="btnCancelAppointment"><property name="text"><string>Hủy Lịch Hẹn (Đang chọn trên bảng)</string></property></widget></item>
      <item><spacer name="verticalSpacer0"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      <!-- KẾT THÚC: NÚT HỦY LỊCH -->

      <item><widget class="QLineEdit" name="txtAppointmentId"><property name="placeholderText"><string>Mã Lịch Hẹn</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtSymptoms"><property name="placeholderText"><string>Triệu chứng</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtDiagnosis"><property name="placeholderText"><string>Chẩn đoán</string></property></widget></item>
      <item><widget class="QLineEdit" name="txtNotes"><property name="placeholderText"><string>Ghi chú thêm</string></property></widget></item>
      <item><widget class="QPushButton" name="btnCreateMedicalRecord"><property name="text"><string>Tạo Bệnh Án</string></property></widget></item>
      <item><spacer name="verticalSpacer1"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      <item><widget class="QLineEdit" name="txtRecordId"><property name="placeholderText"><string>Mã Bệnh Án</string></property></widget></item>
      <item><widget class="QComboBox" name="cbMedicine" /></item>
      <item><widget class="QLineEdit" name="txtDosage"><property name="placeholderText"><string>Liều dùng (VD: 2 viên/ngày)</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayoutPrescribe">
        <item><widget class="QSpinBox" name="spinBoxQuantity"><property name="value"><number>1</number></property></widget></item>
        <item><widget class="QPushButton" name="btnPrescribeMedicine"><property name="text"><string>Kê Đơn Thuốc</string></property></widget></item>
       </layout>
      </item>
      <item><spacer name="verticalSpacer2"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      <item><widget class="QLineEdit" name="txtPatientId_History"><property name="placeholderText"><string>Mã Bệnh Nhân</string></property></widget></item>
      <item><widget class="QPushButton" name="btnViewPatientHistory"><property name="text"><string>Xem Lịch Sử Bệnh Nhân</string></property></widget></item>
      <item><spacer name="verticalSpacer3"><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      <item><widget class="QPushButton" name="btnLogout"><property name="text"><string>Đăng Xuất</string></property></widget></item>
     </layout>
    </item>
   </layout>
  </widget>
 </widget>
</ui>